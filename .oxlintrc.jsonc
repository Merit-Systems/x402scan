{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@merit-systems/oxlint-config/next.jsonc"],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/dist/**",
    "**/build/**",
    "**/generated/**",
    "**/*.gen.ts",
    // Deferred product surfaces are route-owned so they can be excluded as
    // cohesive units without weakening lint coverage for shared production code.
    "apps/scan/src/app/(app)/admin/**",
    "apps/scan/src/app/(app)/composer/**",
    "apps/scan/src/app/api/chat/**",
    "apps/scan/src/components/ai-elements/**",
    "apps/scan/src/components/magicui/animated-shiny-text.tsx",
    "apps/scan/src/components/ui/sidebar.tsx",
    "apps/scan/src/trpc/routers/admin/**",
    "apps/scan/src/trpc/routers/user/**",
    "apps/scan/src/trpc/routers/public/agent-configurations.ts",
    "apps/scan/src/trpc/routers/public/chats.ts",
    "apps/scan/src/trpc/routers/public/tools.ts",
    "apps/scan/src/services/composer-balances/**",
    "apps/scan/src/services/db/agent-config/**",
    "apps/scan/src/services/db/composer/**",
    "apps/scan/src/services/db/composer-balances/**",
    "apps/scan/src/services/db/spending/**",
    "apps/scan/src/services/cdp/server-wallet/admin.ts"
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "nextjs",
    "promise",
    "node"
  ],
  "options": {
    // Foundation adoption is staged: inherited migration findings remain
    // visible, but only the established and high-signal rules block this batch.
    "denyWarnings": false,
    "typeAware": true
  },
  "settings": {
    "tailwindcss": {
      "entryPoint": "apps/scan/src/app/globals.css"
    }
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    // Existing debt exposed by Foundation. Keep these visible as warnings while
    // the visual, route-ownership, environment, hook, and strictness migrations
    // proceed in focused follow-up changes.
    "hooks/set-state-in-effect": "warn",
    "jsx-a11y/click-events-have-key-events": "warn",
    "jsx-a11y/no-static-element-interactions": "warn",
    "jsx-a11y/prefer-tag-over-role": "warn",
    "merit-brand/no-arbitrary-typography": "warn",
    "merit-brand/no-raw-theme-colors": "warn",
    // Bare severities intentionally retain the pre-Foundation rule options.
    // Restoring Foundation's stricter options exposes separate environment and
    // interpolation migrations that do not belong in this safety pass.
    "no-restricted-properties": "warn",
    "no-useless-assignment": "warn",
    "typescript/restrict-plus-operands": "warn",
    "typescript/restrict-template-expressions": "warn",
    "import/no-unassigned-import": "warn",
    "import/no-named-as-default-member": "warn",
    "no-await-in-loop": "warn",
    "no-underscore-dangle": "warn",
    "react/no-array-index-key": "warn",
    "react/no-unstable-nested-components": "warn",
    "react/jsx-no-constructed-context-values": "warn",
    "unicorn/consistent-function-scoping": "warn",
    "unicorn/no-array-sort": "warn",
    "oxc/no-map-spread": "warn",
    // Hono async handlers remain reviewable at their use sites instead of
    // disappearing behind a repository-wide disable.
    "oxc/no-async-endpoint-handlers": "warn",

    // Parity with the previous typescript-eslint config.
    "typescript/consistent-type-imports": [
      "error",
      { "fixStyle": "separate-type-imports" }
    ],
    // Curated additions: high-signal bug catchers not on by default.
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-empty-named-blocks": "error",
    "promise/no-multiple-resolved": "error",
    "unicorn/no-instanceof-builtins": ["error", { "exclude": ["Function"] }],
    "unicorn/require-post-message-target-origin": "error"
  }
}
