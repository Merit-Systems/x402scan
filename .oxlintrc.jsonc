{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@merit-systems/oxlint-config/next.jsonc"],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/dist/**",
    "**/build/**",
    "**/generated/**",
    "**/*.gen.ts"
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "nextjs",
    "promise",
    "node"
  ],
  "options": {
    // Foundation adoption is staged: inherited migration findings remain
    // visible, but only the established and high-signal rules block this batch.
    "denyWarnings": false,
    "typeAware": true
  },
  "settings": {
    "tailwindcss": {
      "entryPoint": "apps/scan/src/app/globals.css"
    }
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }
  ],
  "rules": {
    // Existing debt exposed by Foundation. Keep these visible as warnings while
    // the visual, route-ownership, environment, hook, and strictness migrations
    // proceed in focused follow-up changes.
    "hooks/set-state-in-effect": "warn",
    "hooks/immutability": "warn",
    "hooks/refs": "warn",
    "hooks/static-components": "warn",
    "jsx-a11y/click-events-have-key-events": "warn",
    "jsx-a11y/control-has-associated-label": "warn",
    "jsx-a11y/heading-has-content": "warn",
    "jsx-a11y/img-redundant-alt": "warn",
    "jsx-a11y/label-has-associated-control": "warn",
    "jsx-a11y/media-has-caption": "warn",
    "jsx-a11y/no-noninteractive-element-interactions": "warn",
    "jsx-a11y/no-static-element-interactions": "warn",
    "jsx-a11y/prefer-tag-over-role": "warn",
    "jsx-a11y/role-has-required-aria-props": "warn",
    "merit-brand/no-arbitrary-typography": "warn",
    "merit-brand/no-direct-primitive-imports": "warn",
    "merit-brand/no-raw-theme-colors": "warn",
    "merit-next/no-route-private-imports": "warn",
    "merit-next/prefer-nearest-route-private-owner": "warn",
    "merit-next/require-generated-route-props": "warn",
    "merit-next/require-page-route-group": "warn",
    "no-restricted-properties": "warn",
    "no-useless-assignment": "warn",
    "tailwindcss/no-conflicting-classes": "warn",
    "typescript/consistent-type-definitions": "warn",
    "typescript/no-confusing-void-expression": "warn",
    "typescript/no-deprecated": "warn",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-import-type-side-effects": "warn",
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-unnecessary-condition": "warn",
    "typescript/no-unnecessary-type-arguments": "warn",
    "typescript/no-unnecessary-type-assertion": "warn",
    "typescript/prefer-optional-chain": "warn",
    "typescript/restrict-plus-operands": "warn",
    "typescript/restrict-template-expressions": "warn",
    "typescript/return-await": "warn",
    "typescript/use-unknown-in-catch-callback-variable": "warn",
    "vitest/no-conditional-expect": "warn",
    "vitest/require-mock-type-parameters": "warn",

    // Parity with the previous typescript-eslint config.
    "typescript/consistent-type-imports": [
      "error",
      { "fixStyle": "separate-type-imports" }
    ],
    // Curated additions: high-signal bug catchers not on by default.
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-empty-named-blocks": "error",
    "promise/no-multiple-resolved": "error",
    "unicorn/no-instanceof-builtins": ["error", { "exclude": ["Function"] }],
    "unicorn/require-post-message-target-origin": "error",

    // The app uses the automatic JSX runtime; React never needs importing.
    "react/react-in-jsx-scope": "off",
    // Plain <img> is intentional for external/user-supplied image URLs
    // (screenshots, avatars) that next/image cannot optimize.
    "nextjs/no-img-element": "off",
    // Next.js App Router route handlers are async by design.
    "oxc/no-async-endpoint-handlers": "off",
    // Side-effect imports are load-bearing here (global CSS, instrumentation).
    "import/no-unassigned-import": "off",
    // `import * as z` style namespace member access is intentional.
    "import/no-named-as-default-member": "off",
    // Sequential awaits in loops are deliberate in sync jobs (rate limits).
    "no-await-in-loop": "off",
    // Not enforced by the previous config; too churny to adopt wholesale now.
    "no-shadow": "off",
    "no-underscore-dangle": "off",
    "typescript/no-unsafe-type-assertion": "off",
    // Flags intentional numeric-enum arithmetic (day-count timeframes) and
    // cross-enum network checks the previous typescript-eslint setup accepted.
    "typescript/no-unsafe-enum-comparison": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/consistent-return": "off",
    "react/no-array-index-key": "off",
    "react/no-unstable-nested-components": "off",
    "react/no-object-type-as-default-prop": "off",
    "react/jsx-no-constructed-context-values": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "oxc/no-map-spread": "off",
    "promise/always-return": "off",

    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error"
  },
  "overrides": [
    {
      "files": ["apps/scan/src/components/ui/data-table.tsx"],
      "rules": {
        // Registry code must remain byte-for-byte aligned with Foundation.
        // This check distinguishes a renderer function from a React node; it
        // does not inspect or validate untrusted input.
        "anti-slop/no-runtime-typeof": "off"
      }
    }
  ]
}
