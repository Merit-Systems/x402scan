{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "description": "Build x402 scan Next.js app for production",
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "NEXT_RUNTIME",
        "NODE_ENV",
        "AUTH_SECRET",
        "LMNR_PROJECT_API_KEY",
        "OTEL_SERVICE_NAME",
        "SIGNOZ_INGESTION_KEY",
        "SCAN_DATABASE_*",
        "CDP_*",
        "CRON_*",
        "FREE_TIER_*",
        "INVITE_WALLET_NAME",
        "TRANSFERS_DB_*",
        "STRIPE_*",
        "BLOB_READ_WRITE_TOKEN",
        "REDIS_*",
        "ECHO_*",
        "PARTNERS_CLICKHOUSE_*",
        "JINA_API_KEY",
        "RESOURCE_SEARCH_API_KEY",
        "AGENTCASH_*",
        "OPENAI_API_KEY",
        "OPENROUTER_API_KEY",
        "FREEPIK_API_KEY",
        "DISCORD_*",
        "X402_PAYEE_ADDRESS",
        "SOLANA_RPC_*",
        "BASE_RPC_*",
        "POSTHOG_*",
        "HIDE_TRPC_LOGS",
        "WALLET_KEY",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_BRANCH_URL"
      ]
    },
    "build:deploy": {
      "description": "Build x402 scan app with database migrations",
      "cache": false,
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "NEXT_RUNTIME",
        "NODE_ENV",
        "AUTH_SECRET",
        "LMNR_PROJECT_API_KEY",
        "OTEL_SERVICE_NAME",
        "SIGNOZ_INGESTION_KEY",
        "SCAN_DATABASE_*",
        "CDP_*",
        "CRON_*",
        "FREE_TIER_*",
        "INVITE_WALLET_NAME",
        "TRANSFERS_DB_*",
        "STRIPE_*",
        "BLOB_READ_WRITE_TOKEN",
        "REDIS_*",
        "ECHO_*",
        "PARTNERS_CLICKHOUSE_*",
        "JINA_API_KEY",
        "RESOURCE_SEARCH_API_KEY",
        "AGENTCASH_*",
        "OPENAI_API_KEY",
        "OPENROUTER_API_KEY",
        "FREEPIK_API_KEY",
        "DISCORD_*",
        "X402_PAYEE_ADDRESS",
        "SOLANA_RPC_*",
        "BASE_RPC_*",
        "POSTHOG_*",
        "HIDE_TRPC_LOGS",
        "WALLET_KEY",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_BRANCH_URL"
      ]
    },
    "types:generate": {
      "description": "Generate Next.js route types",
      "outputs": [".next/types/**", ".next/package.json", "next-env.d.ts"],
      "env": [
        "NEXT_PUBLIC_*",
        "NODE_ENV",
        "POSTHOG_*",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_BRANCH_URL"
      ]
    },
    "test": {
      "description": "Run x402 scan tests",
      "env": [
        "NEXT_PUBLIC_*",
        "NODE_ENV",
        "SCAN_DATABASE_*",
        "TRANSFERS_DB_*",
        "PARTNERS_CLICKHOUSE_*",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_BRANCH_URL"
      ]
    },
    "ui:integrity": {
      "cache": false,
      "inputs": [
        "components.json",
        "package.json",
        "tsconfig.json",
        "src/components/**",
        "src/app/globals.css",
        "$TURBO_ROOT$/foundation.config.ts",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ],
      "passThroughEnv": [
        "ACTIONS_ID_TOKEN_REQUEST_TOKEN",
        "ACTIONS_ID_TOKEN_REQUEST_URL"
      ],
      "outputs": []
    },
    "dev": {
      "description": "Start x402 scan app in development mode",
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NEXT_PUBLIC_*",
        "NEXT_RUNTIME",
        "NODE_ENV",
        "AUTH_SECRET",
        "LMNR_PROJECT_API_KEY",
        "OTEL_SERVICE_NAME",
        "SIGNOZ_INGESTION_KEY",
        "SCAN_DATABASE_*",
        "CDP_*",
        "CRON_*",
        "FREE_TIER_*",
        "INVITE_WALLET_NAME",
        "TRANSFERS_DB_*",
        "STRIPE_*",
        "BLOB_READ_WRITE_TOKEN",
        "REDIS_*",
        "ECHO_*",
        "PARTNERS_CLICKHOUSE_*",
        "JINA_API_KEY",
        "RESOURCE_SEARCH_API_KEY",
        "AGENTCASH_*",
        "OPENAI_API_KEY",
        "OPENROUTER_API_KEY",
        "FREEPIK_API_KEY",
        "DISCORD_*",
        "X402_PAYEE_ADDRESS",
        "SOLANA_RPC_*",
        "BASE_RPC_*",
        "POSTHOG_*",
        "HIDE_TRPC_LOGS",
        "WALLET_KEY",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_BRANCH_URL"
      ]
    },
    "start": {
      "description": "Start the built x402 scan app",
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NEXT_PUBLIC_*",
        "NEXT_RUNTIME",
        "NODE_ENV",
        "AUTH_SECRET",
        "LMNR_PROJECT_API_KEY",
        "OTEL_SERVICE_NAME",
        "SIGNOZ_INGESTION_KEY",
        "SCAN_DATABASE_*",
        "CDP_*",
        "CRON_*",
        "FREE_TIER_*",
        "INVITE_WALLET_NAME",
        "TRANSFERS_DB_*",
        "STRIPE_*",
        "BLOB_READ_WRITE_TOKEN",
        "REDIS_*",
        "ECHO_*",
        "PARTNERS_CLICKHOUSE_*",
        "JINA_API_KEY",
        "RESOURCE_SEARCH_API_KEY",
        "AGENTCASH_*",
        "OPENAI_API_KEY",
        "OPENROUTER_API_KEY",
        "FREEPIK_API_KEY",
        "DISCORD_*",
        "X402_PAYEE_ADDRESS",
        "SOLANA_RPC_*",
        "BASE_RPC_*",
        "POSTHOG_*",
        "HIDE_TRPC_LOGS",
        "WALLET_KEY",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_BRANCH_URL"
      ]
    }
  }
}
