{
  "name": "@x402scan/proxy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:app": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "types:check": "tsc --noEmit && tsc --noEmit --project tsconfig.tools.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix ."
  },
  "dependencies": {
    "@t3-oss/env-core": "catalog:env",
    "@hono/node-server": "catalog:hono",
    "dotenv": "catalog:env",
    "hono": "catalog:hono",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@merit-systems/oxlint-config": "catalog:foundation",
    "@merit-systems/typescript-config": "catalog:foundation",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "portless": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "portless": {
    "name": "proxy.x402scan",
    "script": "dev:app"
  }
}
