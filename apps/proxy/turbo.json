{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "description": "Start proxy server in development mode",
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT"]
    },
    "build": {
      "description": "Build proxy server for production",
      "outputs": ["dist/**"]
    },
    "start": {
      "description": "Start proxy server in production mode",
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT"]
    }
  }
}
