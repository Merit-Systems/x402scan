{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "description": "Build package for production",
      "dependsOn": ["^build", "^db:generate"],
      "outputs": ["dist/**"]
    },
    "build:deploy": {
      "description": "Build package with database migrations for deployment",
      "dependsOn": ["^build", "^db:generate", "^db:deploy"],
      "cache": false
    },
    "//#lint:repo": {
      "description": "Lint root-owned TypeScript configuration",
      "inputs": [
        "foundation.config.ts",
        "knip.config.ts",
        "oxfmt.config.ts",
        "oxlint.config.ts",
        "taze.config.ts"
      ],
      "outputs": []
    },
    "//#lint:fix:repo": {
      "description": "Fix lint issues in root-owned TypeScript configuration",
      "cache": false
    },
    "lint": {
      "description": "Lint package-owned source with Oxlint",
      "dependsOn": ["^db:generate", "types:generate", "^build", "db:generate"],
      "outputs": []
    },
    "lint:fix": {
      "description": "Fix lint issues in package-owned source",
      "dependsOn": ["^db:generate", "types:generate", "^build", "db:generate"],
      "cache": false
    },
    "dev": {
      "description": "Start development server with hot reload",
      "dependsOn": ["^build", "^db:generate"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "description": "Start production server",
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "types:generate": {
      "description": "Generate TypeScript types from sources"
    },
    "types:check": {
      "description": "Type-check code with TypeScript compiler",
      "dependsOn": ["^db:generate", "types:generate", "^build", "db:generate"],
      "outputs": []
    },
    "//#format:check": {
      "description": "Check code formatting without modifying files",
      "inputs": [
        "apps/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,jsonc,md,mdx,yml,yaml,css,scss,html}",
        "packages/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,jsonc,md,mdx,yml,yaml,css,scss,html}",
        "sync/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,jsonc,md,mdx,yml,yaml,css,scss,html}",
        ".oxfmtignore",
        "oxfmt.config.ts",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/.next/**",
        "!**/dist/**",
        "!**/generated/**"
      ],
      "outputs": []
    },
    "//#knip": {
      "description": "Find unused files, dependencies, and exports",
      "inputs": [
        "**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json}",
        "knip.config.ts",
        "pnpm-workspace.yaml",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/.next/**",
        "!**/dist/**",
        "!**/generated/**"
      ],
      "outputs": []
    },
    "//#foundation:check": {
      "description": "Validate the repository against Foundation policy",
      "inputs": [
        "foundation.config.ts",
        "package.json",
        "pnpm-workspace.yaml",
        "pnpm-lock.yaml",
        "turbo.json",
        ".github/workflows/**",
        "**/package.json",
        "**/tsconfig*.json",
        "**/oxlint.config.{ts,mts}",
        "!**/node_modules/**",
        "!**/.next/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/generated/**"
      ],
      "outputs": []
    },
    "ui:check": {
      "description": "Validate the product UI against Foundation policy",
      "outputs": []
    },
    "ui:integrity": {
      "description": "Compare owned UI sources with the Merit registry",
      "outputs": []
    },
    "publish:check": {
      "description": "Verify package is ready for npm publishing",
      "cache": false
    },
    "db:generate": {
      "description": "Generate Prisma client from schema"
    },
    "db:migrate": {
      "description": "Create and apply database migrations",
      "cache": false,
      "interactive": true
    },
    "db:deploy": {
      "description": "Deploy pending database migrations to production",
      "cache": false
    },
    "db:format": {
      "description": "Format Prisma schemas",
      "cache": false
    },
    "studio": {
      "description": "Start an interactive database studio",
      "cache": false,
      "persistent": true
    },
    "test": {
      "description": "Run package tests",
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      "outputs": []
    },
    "deploy": {
      "description": "Deploy a package to its hosting provider",
      "dependsOn": ["^build", "^db:generate"],
      "cache": false,
      "outputs": [".trigger/**"]
    },
    "trigger:dev": {
      "description": "Start Trigger.dev background jobs locally",
      "dependsOn": ["^build", "^db:generate"],
      "cache": false,
      "persistent": true
    },
    "trigger:deploy": {
      "description": "Deploy Trigger.dev background jobs",
      "dependsOn": ["^build", "^db:generate"],
      "cache": false
    }
  },
  "remoteCache": {
    "enabled": true
  }
}
