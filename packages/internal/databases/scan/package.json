{
  "name": "@x402scan/scan-db",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "tsup src/* --watch",
    "types:check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/wait-for-db.mjs && prisma migrate deploy",
    "db:format": "prisma format",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "catalog:prisma",
    "@prisma/adapter-neon": "catalog:prisma",
    "@prisma/client": "catalog:prisma",
    "dotenv": "catalog:env",
    "ws": "catalog:prisma"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:prisma",
    "@merit-systems/typescript-config": "catalog:foundation",
    "prisma": "catalog:prisma",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "zod": "catalog:"
  }
}
