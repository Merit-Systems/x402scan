{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "db:generate": {
      "description": "Generate the scan database Prisma client",
      "outputs": ["generated/**"]
    },
    "db:deploy": {
      "description": "Deploy scan database migrations",
      "cache": false,
      "passThroughEnv": ["SCAN_DATABASE_URL_UNPOOLED"]
    },
    "db:migrate": {
      "description": "Create and apply scan database migrations",
      "cache": false,
      "passThroughEnv": ["SCAN_DATABASE_URL_UNPOOLED"]
    },
    "studio": {
      "description": "Start Prisma Studio for the scan database",
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["SCAN_DATABASE_URL_UNPOOLED"]
    }
  }
}
