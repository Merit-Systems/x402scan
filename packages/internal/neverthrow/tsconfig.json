{
  "extends": "@merit-systems/typescript-config/bundled-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "tsup.config.ts", "oxlint.config.ts"],
  "exclude": ["node_modules", "dist"]
}
