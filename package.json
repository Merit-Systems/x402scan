{
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@merit-systems/foundation": "catalog:foundation",
    "@merit-systems/oxfmt-config": "catalog:foundation",
    "@merit-systems/oxlint-config": "catalog:foundation",
    "@merit-systems/taze-config": "catalog:foundation",
    "@merit-systems/typescript-config": "catalog:foundation",
    "knip": "^5.80.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rimraf": "catalog:",
    "taze": "^19.17.2",
    "turbo": "^2.10.10",
    "typescript": "catalog:"
  },
  "name": "@x402scan/monorepo",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "turbo run dev --filter=@x402scan/app",
    "build": "turbo run build",
    "start": "turbo run start",
    "deploy": "turbo run deploy",
    "build:deploy": "turbo run build:deploy",
    "build:packages": "turbo run build --filter \"./packages/external/**\"",
    "clean": "rimraf .turbo node_modules .next dist",
    "lint": "turbo run //#lint:repo",
    "lint:repo": "oxlint",
    "lint:fix": "turbo run //#lint:fix:repo",
    "lint:fix:repo": "oxlint --fix",
    "types:check": "turbo run types:check",
    "types:generate": "turbo run types:generate",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "knip:check": "turbo run knip",
    "test": "turbo run test",
    "ui:check": "turbo run ui:check",
    "ui:integrity": "turbo run ui:integrity",
    "boundaries": "turbo boundaries",
    "check": "turbo run types:check test ui:check ui:integrity publish:check //#lint:repo //#format:check //#knip //#foundation:check && turbo boundaries",
    "trigger:deploy:transfers": "turbo run trigger:deploy --filter=@x402scan/sync-transfers",
    "trigger:deploy:alerts": "turbo run trigger:deploy --filter=@x402scan/sync-alerts",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build:packages && changeset publish",
    "foundation:check": "merit conformance check",
    "deps:check": "taze --fail-on-outdated"
  },
  "version": "1.0.0"
}
